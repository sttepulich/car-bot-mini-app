// Таблица декодирования года выпуска (10-я позиция VIN)
const YEAR_CODE = {
    'A': 2010, 'B': 2011, 'C': 2012, 'D': 2013, 'E': 2014, 'F': 2015,
    'G': 2016, 'H': 2017, 'J': 2018, 'K': 2019, 'L': 2020, 'M': 2021,
    'N': 2022, 'P': 2023, 'R': 2024, 'S': 2025, 'T': 2026, 'V': 2027,
    'W': 2028, 'X': 2029, 'Y': 2030,
    '1': 2001, '2': 2002, '3': 2003, '4': 2004, '5': 2005,
    '6': 2006, '7': 2007, '8': 2008, '9': 2009,
};

/**
 * Валидация VIN номера
 */
function validateVIN(vin) {
    vin = vin.trim().toUpperCase();
    
    if (vin.length !== 17) {
        return {
            valid: false,
            error: `❌ VIN должен содержать 17 символов (у вас ${vin.length})`
        };
    }
    
    // Проверка допустимых символов (I, O, Q не используются)
    if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(vin)) {
        return {
            valid: false,
            error: '❌ VIN содержит недопустимые символы (I, O, Q не используются)'
        };
    }
    
    return { valid: true, vin: vin };
}

/**
 * Декодирование года выпуска из 10-й позиции VIN
 */
function decodeYear(vin) {
    if (vin.length < 10) return null;
    const yearChar = vin[9].toUpperCase();
    return YEAR_CODE[yearChar] || null;
}

/**
 * Декодирование VIN
 */
function decodeVIN(vinInput) {
    const validation = validateVIN(vinInput);
    if (!validation.valid) {
        return {
            success: false,
            error: validation.error
        };
    }
    
    const vin = validation.vin;
    const wmi = vin.substring(0, 3);
    const year = decodeYear(vin);
    
    // Ищем в базе WMI
    if (WMI_DATABASE[wmi]) {
        const data = WMI_DATABASE[wmi];
        return {
            success: true,
            vin: vin,
            brand: data.brand,
            country: data.country,
            models: data.models,
            year: year,
            wmi: wmi,
            found: true
        };
    }
    
    // VIN валиден, но производитель неизвестен
    return {
        success: true,
        vin: vin,
        brand: null,
        country: null,
        models: [],
        year: year,
        wmi: wmi,
        found: false,
        warning: `⚠️ Производитель с WMI "${wmi}" не найден в базе.`
    };
}

/**
 * Получить информацию о VIN для отображения
 */
function getVINInfo(vin) {
    const validation = validateVIN(vin);
    if (!validation.valid) {
        return validation.error;
    }
    
    const decoded = decodeVIN(vin);
    if (!decoded.success) {
        return decoded.error;
    }
    
    let info = `🔍 Анализ VIN: ${decoded.vin}\n\n`;
    info += `🏭 WMI код: ${decoded.wmi}\n`;
    
    if (decoded.found) {
        info += `🚗 Производитель: ${decoded.brand}\n`;
        info += `🌍 Страна производства: ${decoded.country}\n`;
        if (decoded.models && decoded.models.length > 0) {
            info += `📋 Возможные модели: ${decoded.models.join(', ')}\n`;
        }
    } else {
        info += `⚠️ Производитель не найден в базе\n`;
    }
    
    if (decoded.year) {
        info += `📅 Год выпуска: ${decoded.year}\n`;
    } else {
        info += `📅 Год выпуска: не определён\n`;
    }
    
    return info;
}

/**
 * Поиск производителя по названию (для автокомплита)
 */
function searchBrands(query) {
    query = query.toLowerCase();
    const brands = new Set();
    
    Object.values(WMI_DATABASE).forEach(data => {
        if (data.brand.toLowerCase().includes(query)) {
            brands.add(data.brand);
        }
    });
    
    return Array.from(brands).sort();
}

/**
 * Получить все уникальные марки из базы
 */
function getAllBrands() {
    const brands = new Set();
    Object.values(WMI_DATABASE).forEach(data => {
        brands.add(data.brand);
    });
    return Array.from(brands).sort();
}

// Экспорт функций
window.VINDecoder = {
    validateVIN,
    decodeVIN,
    getVINInfo,
    decodeYear,
    searchBrands,
    getAllBrands,
    WMI_DATABASE,
    YEAR_CODE
};
